{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "timing",
  "description": "时间轴真相源。机器生成，禁止手改。",
  "type": "object",
  "required": ["version", "audio", "duration_ms", "backend", "segments", "invariants"],
  "properties": {
    "version": { "type": "string" },
    "audio": { "type": "string" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "backend": { "type": "string" },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start_ms", "end_ms", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^t[0-9]{3}$" },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" },
          "seg_ref": { "type": "string", "description": "对应 script.json 的 segment id" },
          "match": { "type": "number", "description": "锚点覆盖率 0-1" },
          "ok": { "type": "boolean" },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "start_ms", "end_ms"],
              "properties": {
                "text": { "type": "string" },
                "start_ms": { "type": "integer" },
                "end_ms": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "invariants": {
      "type": "object",
      "required": ["no_overlap", "max_gap_ms", "ends_within_ms"],
      "properties": {
        "no_overlap": { "type": "boolean" },
        "max_gap_ms": { "type": "number", "description": "相邻段最大间隙" },
        "ends_within_ms": { "type": "number", "description": "末段结束与音频总时长最大偏差" }
      }
    }
  }
}
